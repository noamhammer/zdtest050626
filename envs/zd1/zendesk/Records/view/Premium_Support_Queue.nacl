zendesk.view Premium_Support_Queue@s {
  active = true
  default = false
  description = "Unsolved tickets tagged premium_support, highest priority first."
  execution = {
    group_order = "desc"
    sort_by = "priority"
    sort_order = "desc"
    sort = {
      id = "priority"
      title = "Priority"
      filterable = true
      sortable = true
      order = "desc"
    }
    columns = [
      {
        id = "custom_status_id"
        title = "Ticket status"
        filterable = true
        sortable = false
      },
      {
        id = "ticket_id"
        title = "ID"
        filterable = true
        sortable = true
      },
      {
        id = "subject"
        title = "Subject"
        filterable = true
        sortable = true
      },
      {
        id = "priority"
        title = "Priority"
        filterable = true
        sortable = true
      },
      {
        id = "sla_next_breach_at"
        title = "SLA"
        filterable = true
        sortable = true
      },
      {
        id = "requester"
        title = "Requester"
        filterable = true
        sortable = true
      },
      {
        id = "assignee"
        title = "Assignee"
        filterable = true
        sortable = true
      },
      {
        id = "created"
        title = "Requested"
        filterable = false
        sortable = true
      },
    ]
    fields = [
      {
        id = "custom_status_id"
        title = "Ticket status"
        filterable = true
        sortable = false
      },
      {
        id = "ticket_id"
        title = "ID"
        filterable = true
        sortable = true
      },
      {
        id = "subject"
        title = "Subject"
        filterable = true
        sortable = true
      },
      {
        id = "priority"
        title = "Priority"
        filterable = true
        sortable = true
      },
      {
        id = "sla_next_breach_at"
        title = "SLA"
        filterable = true
        sortable = true
      },
      {
        id = "requester"
        title = "Requester"
        filterable = true
        sortable = true
      },
      {
        id = "assignee"
        title = "Assignee"
        filterable = true
        sortable = true
      },
      {
        id = "created"
        title = "Requested"
        filterable = false
        sortable = true
      },
    ]
  }
  conditions = {
    all = [
      {
        field = "status"
        operator = "less_than"
        value = "solved"
      },
      {
        field = "current_tags"
        operator = "includes"
        value = [
          "premium_support",
        ]
      },
      {
        field = "support_type"
        operator = "is"
        value = "0"
      },
    ]
  }
  raw_title = "Premium Support Queue"
  _alias = "Premium Support Queue"
}
