zendesk.view Finance___Refunds___billing_disputes@sbssess {
  active = true
  default = false
  description = "All open refund requests, invoice disputes and chargebacks flagged for Finance. Read-only for Finance."
  execution = {
    group_by = "custom_field"
    group_order = "asc"
    sort_by = "updated"
    sort_order = "asc"
    group = {
      id = "custom_field"
      order = "asc"
    }
    sort = {
      id = "updated"
      title = "Updated"
      filterable = true
      sortable = true
      order = "asc"
    }
    columns = [
      {
        id = "subject"
        title = "Subject"
        filterable = true
        sortable = true
      },
      {
        id = "requester"
        title = "Requester"
        filterable = true
        sortable = true
      },
      {
        id = "assignee"
        title = "Assignee"
        filterable = true
        sortable = true
      },
      {
        id = "status"
        title = "Status category"
        filterable = true
        sortable = true
      },
      {
        id = "updated"
        title = "Updated"
        filterable = true
        sortable = true
      },
    ]
    fields = [
      {
        id = "subject"
        title = "Subject"
        filterable = true
        sortable = true
      },
      {
        id = "requester"
        title = "Requester"
        filterable = true
        sortable = true
      },
      {
        id = "assignee"
        title = "Assignee"
        filterable = true
        sortable = true
      },
      {
        id = "status"
        title = "Status category"
        filterable = true
        sortable = true
      },
      {
        id = "updated"
        title = "Updated"
        filterable = true
        sortable = true
      },
    ]
  }
  conditions = {
    all = [
      {
        field = "current_tags"
        operator = "includes"
        value = [
          zendesk.tag.instance.finance_review,
        ]
      },
      {
        field = "status"
        operator = "less_than"
        value = "closed"
      },
    ]
  }
  raw_title = "Finance - Refunds & billing disputes"
  _alias = "Finance - Refunds & billing disputes"
}
